FROM node:24-alpine

ENV CI=true

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsdown.devCdn.config.ts .npmrc ./
COPY src ./src

RUN pnpm install --frozen-lockfile \
  && pnpm exec tsdown --c tsdown.devCdn.config.ts
ENV CDN_DATA_DIR=/data
VOLUME ["/data"]

EXPOSE 8003

CMD ["node", "--enable-source-maps", "dist/dev-cdn/devCdnEntry.mjs"]
