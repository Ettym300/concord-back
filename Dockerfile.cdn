FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml tsconfig.json tsdown.devCdn.config.ts ./
COPY src ./src

RUN pnpm install --frozen-lockfile \
  && pnpm exec tsdown --c tsdown.devCdn.config.ts

EXPOSE 8003

CMD ["node", "--enable-source-maps", "dist/dev-cdn/devCdnEntry.mjs"]
